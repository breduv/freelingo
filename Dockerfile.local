# Local patch build only; upstream service Dockerfiles remain unchanged.
# Keep the source revision and backend runtime aligned when updating upstream.
ARG UPSTREAM_BACKEND_IMAGE=ghcr.io/artcc/freelingo-backend@sha256:2361323bb9e0d423557b86d5cad693354472f3ae6f26cec6f9099657d5967c62
ARG KOKORO_BASE_IMAGE=ghcr.io/remsky/kokoro-fastapi-gpu@sha256:f027cfc59d7ae3cb283365248b3177c68d36bc5701c1385783a285262316687b

FROM node:26.13.0-alpine AS patched-source
ARG UPSTREAM_REF=00d5aa4eac8d138b7a919b74ff78992ecf1a31f1
WORKDIR /upstream
ADD https://github.com/artcc/freelingo/archive/${UPSTREAM_REF}.tar.gz /tmp/upstream.tar.gz
RUN tar -xzf /tmp/upstream.tar.gz --strip-components=1 -C /upstream && rm /tmp/upstream.tar.gz

# Only these local files replace/add to the pinned original source.
COPY backend/app/core/config.py /upstream/backend/app/core/config.py
COPY backend/app/main.py /upstream/backend/app/main.py
COPY backend/app/routers/llm_settings.py /upstream/backend/app/routers/llm_settings.py
COPY backend/app/services/llm_adapter.py backend/app/services/llm_config.py backend/app/services/chatgpt_auth.py /upstream/backend/app/services/
COPY backend/app/services/tts_service.py backend/app/services/tour_audio.py /upstream/backend/app/services/
COPY backend/app/routers/phrasebook.py /upstream/backend/app/routers/phrasebook.py
COPY backend/requirements.txt backend/constraints.txt /upstream/backend/
COPY ["frontend/src/app/(app)/settings/page.tsx", "/upstream/frontend/src/app/(app)/settings/page.tsx"]
COPY ["frontend/src/app/(app)/settings/ai/page.tsx", "/upstream/frontend/src/app/(app)/settings/ai/page.tsx"]
COPY messages/ /upstream/messages/

FROM ${UPSTREAM_BACKEND_IMAGE} AS backend
WORKDIR /app
COPY --from=patched-source /upstream/backend/requirements.txt /upstream/backend/constraints.txt ./
# Existing pins are retained; the OAuth/encryption dependency must also be installed.
RUN python -m pip install --no-cache-dir -r requirements.txt
COPY --from=patched-source /upstream/backend/app ./app
COPY --from=patched-source /upstream/backend/alembic ./alembic
COPY --from=patched-source /upstream/backend/alembic.ini ./alembic.ini

FROM ${KOKORO_BASE_IMAGE} AS kokoro
USER root
RUN mkdir -p /data/models /etc/kokoro /opt/freelingo-kokoro \
    && chown -R appuser:appuser /data/models /opt/freelingo-kokoro
USER appuser
WORKDIR /opt/freelingo-kokoro
COPY deploy/kokoro/requirements.txt ./requirements.txt
RUN python -m ensurepip --upgrade \
    && python -m pip install --no-cache-dir -r requirements.txt
COPY deploy/kokoro/ ./
ENV HF_HOME=/data/models/huggingface \
    HF_HUB_DISABLE_PROGRESS_BARS=1 \
    KOKORO_DEVICE=cuda \
    KOKORO_VOICES_FILE=/etc/kokoro/voices.json
COPY deploy/kokoro/voices.json /etc/kokoro/voices.json
ENTRYPOINT []
CMD ["python", "-m", "uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8880", "--no-access-log"]

FROM node:26.13.0-alpine AS frontend-deps
WORKDIR /app
RUN npm install -g npm@11.20.0
COPY --from=patched-source /upstream/frontend/package.json /upstream/frontend/package-lock.json ./
COPY --from=patched-source /upstream/frontend/scripts ./scripts
RUN npm ci

FROM node:26.13.0-alpine AS frontend-builder
WORKDIR /app
COPY --from=frontend-deps /app/node_modules ./node_modules
COPY --from=patched-source /upstream/frontend/ ./
COPY --from=patched-source /upstream/messages/ ./messages/
RUN node scripts/copy-vad-models.js
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:26.13.0-alpine AS frontend
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=frontend-builder /app/public ./public
COPY --from=frontend-builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=frontend-builder --chown=nextjs:nodejs /app/.next/static ./.next/static
USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
CMD ["node", "server.js"]
